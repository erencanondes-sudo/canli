rules_version = '2';

/*
 * Firestore kuralları
 * Uygulama yalnızca okur (zil kaydı hariç); yazmayı sunucu yapar (sunucu bu kurallara takılmaz).
 * Yönetici (yonetim.html) analizleri yazar; elle düzeltme kilitlerini ve sunucuya istekleri (istek) yazar, sunucu dinler.
 * Gün listesi, Özet ve maç içerikleri odalarda ve R2'de (Firestore'da değil).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Yönetim sayfası: elle/{maç} kilit { s, d?, o?, t }; istek/{tür}_{maç} { tur, mac?, t } (sunucu işleyip siler).
     * Yalnızca yönetici okur ve yazar.
     */
    match /elle/{mac} {
      allow read, delete: if request.auth != null && request.auth.uid == 'Uub6yQU2vnYPa2pOWXxumPjkUMN2';
      allow create, update: if request.auth != null && request.auth.uid == 'Uub6yQU2vnYPa2pOWXxumPjkUMN2'
        && mac.matches('^[0-9]{1,10}$')
        && request.resource.data.keys().hasOnly(['s', 'd', 'o', 't'])
        && request.resource.data.s is string;
    }

    match /istek/{ad} {
      allow read, write: if request.auth != null && request.auth.uid == 'Uub6yQU2vnYPa2pOWXxumPjkUMN2'
        && ad.matches('^(yenile_[0-9]{1,10}|hizli_sil_[0-9]{1,10}|hizli_sil_hepsi)$');
    }

    /* Oranlar: günün ve ligin menü oranları (maçın bütün oranları maç odasında) */
    match /oran_gun/{gun} {
      allow read: if true;
      allow write: if false;
    }

    match /oran_lig/{lig} {
      allow read: if true;
      allow write: if false;
    }

    /*
     * Analizler: maç, gün, lig ve dizin dokümanları; AI Kuponu havuzu. Herkes okur; yalnızca yönetici (yonetim.html ile) yazar.
     * analiz_futbol, analiz_nba, analiz_gun, analiz_nba_gun, analiz_lig, analiz_nba_lig, analiz_dizin, kupon_gun
     */
    match /{koleksiyon}/{belge} {
      allow read: if koleksiyon in ['analiz_futbol', 'analiz_nba', 'analiz_gun', 'analiz_nba_gun',
                                    'analiz_lig', 'analiz_nba_lig', 'analiz_dizin', 'kupon_gun'];
      allow write: if koleksiyon in ['analiz_futbol', 'analiz_nba', 'analiz_gun', 'analiz_nba_gun',
                                     'analiz_lig', 'analiz_nba_lig', 'analiz_dizin', 'kupon_gun']
        && request.auth != null && request.auth.uid == 'Uub6yQU2vnYPa2pOWXxumPjkUMN2';
    }

    /* Zil kayıtları artık Cloudflare'de (bildirim odası); eski zil/{cihaz} kayıtlarını sunucu siler */

    /* Geri kalan her şey (sistem/durum dahil) kapalı */
    match /{belge=**} {
      allow read, write: if false;
    }
  }
}
