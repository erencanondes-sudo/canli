rules_version = '2';

/*
 * Firestore kuralları
 * Uygulama yalnızca okur (zil kaydı hariç); yazmayı sunucu yapar (sunucu bu kurallara takılmaz).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    match /gun/{gun} {
      allow read: if true;
      allow write: if false;
    }

    match /ozet/{gun} {
      allow read: if true;
      allow write: if false;
    }

    match /maclar/{mac} {
      allow read: if true;
      allow write: if false;
    }

    /* Oranlar: maçın bütün oranları, günün ve ligin menü oranları */
    match /oran_mac/{mac} {
      allow read: if true;
      allow write: if false;
    }

    match /oran_gun/{gun} {
      allow read: if true;
      allow write: if false;
    }

    match /oran_lig/{lig} {
      allow read: if true;
      allow write: if false;
    }

    /*
     * Analizler: maç, gün, lig ve dizin dokümanları. Herkes okur; yalnızca yönetici (yonetim.html ile) yazar.
     * analiz_futbol, analiz_nba, analiz_gun, analiz_nba_gun, analiz_lig, analiz_nba_lig, analiz_dizin
     */
    match /{koleksiyon}/{belge} {
      allow read: if koleksiyon in ['analiz_futbol', 'analiz_nba', 'analiz_gun', 'analiz_nba_gun',
                                    'analiz_lig', 'analiz_nba_lig', 'analiz_dizin'];
      allow write: if koleksiyon in ['analiz_futbol', 'analiz_nba', 'analiz_gun', 'analiz_nba_gun',
                                     'analiz_lig', 'analiz_nba_lig', 'analiz_dizin']
        && request.auth != null && request.auth.uid == 'Uub6yQU2vnYPa2pOWXxumPjkUMN2';
    }

    /* Zil kayıtları: herkes yalnızca kendi kaydını yazar (görünmez giriş), kimse okuyamaz */
    match /zil/{kimlik} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == kimlik
        && request.resource.data.keys().hasOnly(['token', 'maclar', 'guncellendi'])
        && request.resource.data.token is string
        && request.resource.data.token.size() < 400
        && request.resource.data.maclar is list
        && request.resource.data.maclar.size() <= 100;
      allow delete: if false;
    }

    /* Geri kalan her şey (sistem/durum dahil) kapalı */
    match /{belge=**} {
      allow read, write: if false;
    }
  }
}
